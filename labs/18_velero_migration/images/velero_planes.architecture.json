  "cards": [
    {
      "dot": "cyan",
      "title": "两条数据平面",
      "items": [
        "API 对象面：controller 导出对象打 tarball，只依赖 API server",
        "文件系统备份：node agent 打包 PVC 文件，跨集群迁移主力",
        "CSI 快照：最快但留在原存储，跨集群读不到（17 的主题）"
      ]
    },
    {
      "dot": "rose",
      "title": "迁移的灵魂：namespace mapping",
      "items": [
        "--namespace-mappings 源:目标，对象改名后重建",
        "PVC 重新动态供给，node agent 把文件数据灌回去",
        "--exclude-resources events,endpoints：垃圾对象不要恢复"
      ]
    },
    {
      "dot": "emerald",
      "title": "诚实预期与一致性",
      "items": [
        "hostPath 卷不支持文件级备份（kind local-path 的限制）",
        "备份一致性靠 hooks：pre 打快照/锁表，post 解锁",
        "RPO=备份频率（schedule 定时）；RTO≈恢复+重供给+回灌"
      ]
    }
  ]
