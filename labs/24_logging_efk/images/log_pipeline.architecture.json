  "cards": [
    {
      "dot": "cyan",
      "title": "为什么 tail 文件",
      "items": [
        "应用只往 stdout 打印，完全不感知采集器",
        "容器崩溃后日志仍在磁盘不丢失",
        "与运行时无关——docker/containerd 换来换去管道不变"
      ]
    },
    {
      "dot": "rose",
      "title": "kubernetes filter",
      "items": [
        "用 SA 反查 API Server：注入 ns/pod/container 元数据",
        "Merge_Log On 把 JSON 日志体展开成结构化字段",
        "RBAC 只授 pods/namespaces 只读，够用即最小权限"
      ]
    },
    {
      "dot": "emerald",
      "title": "索引与覆盖",
      "items": [
        "按天分索引：删 30 天前数据 = 删整个索引（秒级），生产配 ILM",
        "tolerations Exists：控制面节点的 kubelet/etcd 日志也要采",
        "Mem_Buf_Limit 防打爆节点；高频 DEBUG 先采样丢弃"
      ]
    }
  ]
}