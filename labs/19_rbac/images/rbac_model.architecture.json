  "cards": [
    {
      "dot": "cyan",
      "title": "四件套矩阵",
      "items": [
        "Role / ClusterRole 是\"规则\"，Binding 决定\"生效范围\"",
        "RoleBinding + ClusterRole = 规则复用但权限不出 ns（推荐）",
        "ClusterRole + ClusterRoleBinding 才是全集群生效"
      ]
    },
    {
      "dot": "rose",
      "title": "规则三要素与坑",
      "items": [
        "apiGroups / resources / verbs；子资源 pods/log 要单独列出",
        "deployments 在 apps 组；集群级资源用 Role 授权永不生效",
        "roleRef 不可变：换角色只能删了重建；权限只加不减（并集）"
      ]
    },
    {
      "dot": "emerald",
      "title": "验证三件套",
      "items": [
        "kubectl auth can-i 预演判定（无副作用，CI 断言利器）",
        "--as 模拟真实请求，亲眼看 Forbidden",
        "describe rolebinding 查绑定链两端"
      ]
    }
  ]
