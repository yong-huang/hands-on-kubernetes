  "cards": [
    {
      "dot": "cyan",
      "title": "Trace / Span",
      "items": [
        "trace-id 全局唯一，span 记录耗时并以 parent 构成树",
        "瀑布图宽度 = 自身耗时：db INSERT 40ms 一眼见瓶颈",
        "断链症状：大量单 span 孤儿 trace——某层没透传 traceparent"
      ]
    },
    {
      "dot": "rose",
      "title": "埋点两条路（殊途同归）",
      "items": [
        "生产：OTel Operator 注解注入 init 容器拷 agent，零代码侵入",
        "本实验：容器内 pip 自装 SDK，显式 init Provider/exporter/透传",
        "service.name 决定 Jaeger 服务名；换语言只是换注解"
      ]
    },
    {
      "dot": "emerald",
      "title": "OTLP 与采样",
      "items": [
        "OTLP gRPC :4317 厂商中立，换后端（Jaeger→Tempo）只改 collector",
        "head 采样 1~10% 控制存储成本",
        "tail 采样把错误与慢请求 100% 保留——排障最需要的正是它们"
      ]
    }
  ]
