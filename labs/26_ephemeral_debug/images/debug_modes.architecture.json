  "cards": [
    {
      "dot": "cyan",
      "title": "临时容器的三条限制",
      "items": [
        "不能声明 ports / probes / lifecycle / resources（env 允许）",
        "不能重启——诊断手段，不是修复手段",
        "看完病随 Pod 一起消失，不留痕迹"
      ]
    },
    {
      "dot": "rose",
      "title": "--target 是关键",
      "items": [
        "默认 PID 隔离：不加 target 只是在空壳里装忙",
        "共享 PID ns 后：ps 看进程、读 /proc/<pid>/root、gdb attach",
        "坑：containerd 对已退出容器 --target 会 CreateContainerError"
      ]
    },
    {
      "dot": "emerald",
      "title": "工具箱与安全",
      "items": [
        "netshoot：tcpdump/dig/mtr 网络瑞士军刀；busybox 胜在轻量",
        "ubuntu 适合 chroot 宿主机场景（systemctl/journalctl/ipvsadm）",
        "调试镜像只进 ephemeralContainers；写权限单独 RBAC 收敛"
      ]
    }
  ]
}