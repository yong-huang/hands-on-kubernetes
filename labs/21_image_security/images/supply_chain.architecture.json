  "cards": [
    {
      "dot": "cyan",
      "title": "报告即资源",
      "items": [
        "VulnerabilityReport 是 CRD：summary + CVE 明细 + fixedVersion",
        "消费方不止人：Grafana 趋势 / Kyverno 判定 / CI jq 门禁",
        "ignoreUnfixed=true 只留\"可行动\"的洞，避免告警疲劳"
      ]
    },
    {
      "dot": "rose",
      "title": "扫描 vs 验签",
      "items": [
        "扫描管已知漏洞（事后画像），验签管恶意篡改（来源可信）",
        "verifyImages 在 webhook 路径做 cosign verify，Enforce 直接拒",
        "两者互补：扫描有盲区，验签不看漏洞"
      ]
    },
    {
      "dot": "emerald",
      "title": "灰度与坑",
      "items": [
        "Audit 先行收集违规面 → kubectl patch 切 Enforce",
        "必须带 namespace exclude，否则误伤系统组件",
        "演示按 tag 拦截模拟；生产应真接 VulnerabilityReport 做门禁"
      ]
    }
  ]
