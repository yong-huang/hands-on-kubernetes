  "cards": [
    {
      "dot": "cyan",
      "title": "三层 CRD = PV/PVC 的时间维度复刻",
      "items": [
        "VolumeSnapshot：用户请求（namespaced，指向源 PVC）",
        "VolumeSnapshotContent：集群级句柄，对应后端真实快照",
        "VolumeSnapshotClass：driver + deletionPolicy（Delete/Retain）"
      ]
    },
    {
      "dot": "rose",
      "title": "谁实现了快照接口",
      "items": [
        "snapshot-controller 只做转发：找 Class 里的 driver 调 gRPC",
        "CreateSnapshot 是 CSI 驱动的可选实现（EBS/Longhorn/Ceph 有）",
        "kind local-path 没实现 → readyToUse 永远 false，还原 PVC 一直 Pending"
      ]
    },
    {
      "dot": "emerald",
      "title": "还原与分工",
      "items": [
        "dataSource 三种：VolumeSnapshot / PVC 克隆 / Content",
        "恢复 = 新建 PVC 换卷，不能原地灌回（一致性无法保证）",
        "CSI 快照管卷数据同集群；Velero 管对象 + 跨集群"
      ]
    }
  ]
