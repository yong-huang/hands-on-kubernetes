  "cards": [
    {
      "dot": "cyan",
      "title": "时间语义",
      "items": [
        "tick 精度分钟级；时区是控制器所在时区（通常 UTC）",
        "suspend: true 暂停所有后续调度，配置与历史保留",
        "手动触发一次：kubectl create job --from=cronjob/X"
      ]
    },
    {
      "dot": "rose",
      "title": "至少一次触发",
      "items": [
        "控制器恢复后可能连补多个错过的 tick",
        "任务必须写成幂等的",
        "配 concurrencyPolicy 决定重叠时的行为"
      ]
    },
    {
      "dot": "emerald",
      "title": "历史管理",
      "items": [
        "successfulJobsHistoryLimit 保留成功 Job 供查日志",
        "failedJobsHistoryLimit 保留失败 Job 便于排查",
        "超出的历史 Job 自动删除，防 etcd 膨胀"
      ]
    }
  ]
